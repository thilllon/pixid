{
  // Covers the TypeScript that belongs to the repository rather than to a
  // published package: the README asset generator and the workspace-level e2e
  // suite. Each package has its own tsconfig extending the same base.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["assets/**/*.ts", "packages/e2e/**/*.ts"]
}
