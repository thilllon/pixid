{
  "name": "pixid-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/pixid.git"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "assets": "node assets/generate.ts",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --recursive exec tsc --noEmit -p tsconfig.json",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "check": "pnpm build && pnpm --workspace-root run --parallel \"/^(lint|typecheck|test|format:check)$/\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@pixid/core": "workspace:^",
    "@pixid/png": "workspace:^",
    "@types/node": "^26.5.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jiti": "^2.7.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
