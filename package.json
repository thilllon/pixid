{
  "name": "pixid-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/pixid.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --project unit",
    "e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write --list-different .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@pixid/core": "workspace:^",
    "@pixid/png": "workspace:^",
    "@pixid/svg": "workspace:^",
    "@types/node": "^26.3.0",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "pixid": "workspace:^",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "verdaccio": "^6.10.0",
    "vitest": "^4.1.11"
  }
}
