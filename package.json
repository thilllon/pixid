{
  "name": "pixid-packages",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/pixid.git"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "assets": "node assets/generate.ts",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --project tsconfig.json && pnpm --recursive exec tsc --noEmit --project tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm build && pnpm --workspace-root run --parallel \"/^(lint|typecheck|test:unit|format:check)$/\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@pixid/core": "workspace:^",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
