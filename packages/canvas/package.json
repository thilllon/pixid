{
  "name": "@pixid/canvas",
  "version": "0.2.0",
  "description": "Renders pixid blocky identicons to an HTML canvas element in the browser.",
  "keywords": [
    "identicon",
    "blockies",
    "avatar",
    "canvas",
    "pixel"
  ],
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/pixid.git",
    "directory": "packages/canvas"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@pixid/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
