{
  "name": "@pixid/png",
  "version": "0.2.0",
  "description": "Encodes pixid blocky identicons as PNG (Uint8Array or data URL) with a built-in zero-dependency encoder. Works in Node, browsers, and edge runtimes.",
  "keywords": [
    "identicon",
    "blockies",
    "avatar",
    "png",
    "pixel"
  ],
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/pixid.git",
    "directory": "packages/png"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@pixid/core": "workspace:^"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
