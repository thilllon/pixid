{
  "name": "@pixid/react",
  "version": "0.1.1",
  "description": "React component for pixid blocky identicons. Renders inline SVG, works in server components, no client-side requirements.",
  "keywords": [
    "identicon",
    "blockies",
    "avatar",
    "react",
    "pixel"
  ],
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thilllon/pixid.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@pixid/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@pixid/svg": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
