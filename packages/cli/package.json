{
  "name": "@pixid/cli",
  "version": "0.1.1",
  "description": "Command-line blocky identicon generator. Writes deterministic PNG or SVG identicons from any seed string (npx @pixid/cli).",
  "keywords": [
    "identicon",
    "blockies",
    "avatar",
    "ethereum",
    "pixel",
    "cli",
    "png",
    "svg"
  ],
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/pixid.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./run": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pixid": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@pixid/png": "workspace:^",
    "@pixid/svg": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
