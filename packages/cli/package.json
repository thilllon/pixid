{
  "name": "pixid",
  "version": "0.1.0",
  "description": "Blocky identicon generator. Deterministic pixel avatars from any seed string, as SVG, PNG, or data URLs, plus a CLI (npx pixid). Tree-shakeable re-export of @pixid/core, @pixid/svg, and @pixid/png.",
  "keywords": [
    "identicon",
    "blockies",
    "avatar",
    "ethereum",
    "pixel",
    "cli",
    "png",
    "svg"
  ],
  "license": "MIT",
  "author": "thilllon",
  "repository": {
    "type": "git",
    "url": "https://github.com/thilllon/pixid.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thilllon/pixid",
  "bugs": {
    "url": "https://github.com/thilllon/pixid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "pixid": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@pixid/core": "workspace:^",
    "@pixid/png": "workspace:^",
    "@pixid/svg": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
